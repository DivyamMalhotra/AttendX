{
  "name": "attendx-frontend",
  "version": "2.0.0",
  "private": true,
  "description": "AttendX web client (static HTML/CSS/ES modules) + a tiny dev/prod server that proxies /api to the backend",
  "main": "server.js",
  "engines": { "node": ">=18.17" },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:css": "node scripts/build-css.js",
    "check:css": "node scripts/build-css.js --check"
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "http-proxy-middleware": "^3.0.5"
  }
}
