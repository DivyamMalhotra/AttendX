{
  "name": "attendx",
  "version": "2.0.0",
  "private": true,
  "description": "AttendX university ERP. The server is in backend/, the browser app in frontend/. All dependencies live in backend/.",
  "scripts": {
    "start": "npm --prefix backend start",
    "dev": "npm --prefix backend run dev",
    "install:all": "npm --prefix backend install",
    "local": "npm --prefix backend run local",
    "dev:db": "npm --prefix backend run dev:db",
    "seed:campus": "npm --prefix backend run seed:campus",
    "test": "npm --prefix backend test",
    "test:e2e": "npm --prefix backend run test:e2e",
    "build:css": "node frontend/scripts/build-css.js"
  }
}
