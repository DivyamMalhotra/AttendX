# ===== AttendX backend (development defaults - ready to run) =====
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/attendx
SESSION_SECRET=eb062a793ef538fc7a9cb227a15666a27e743d7a12a2be40fbbc9611bdec031503d44a6b31b557a5fdda49599b017654
SESSION_TTL_HOURS=8
COOKIE_SECURE=auto
# The frontend server proxies /api to this backend, so requests arrive from 127.0.0.1: trust its X-Forwarded-For
TRUST_PROXY=1
# URL of the web UI (used for password-reset links and CORS)
FRONTEND_URL=http://localhost:5173
APP_BASE_URL=http://localhost:5173
CORS_ORIGINS=
BCRYPT_ROUNDS=10
PAYMENT_PROVIDER=simulator
