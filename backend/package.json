{
  "name": "attendx-erp",
  "version": "2.0.0",
  "description": "AttendX backend: Express API, MongoDB models, tests (the browser app is in ../frontend)",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 \"tests/integration/**/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/**/*.test.js\"",
    "admin:create": "node scripts/create-admin.js",
    "migrate:roles": "node scripts/migrations/seven-roles.js",
    "seed:5g3": "node scripts/seed-5g3.js",
    "seed:demo": "node scripts/seed-demo.js",
    "db:audit-rollnos": "node scripts/migrations/audit-duplicate-roll-numbers.js",
    "db:sync-indexes": "node scripts/migrations/sync-indexes.js",
    "db:import-legacy": "node scripts/migrations/import-legacy-localstorage.js",
    "local": "node scripts/local.js",
    "dev:db": "node scripts/dev-db.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "seed:campus": "node scripts/seed-campus-demo.js",
    "test:e2e": "playwright test",
    "db:phase2": "node scripts/migrations/phase2-upgrade.js",
    "build:css": "node ../frontend/scripts/build-css.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.6.1",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  }
}
