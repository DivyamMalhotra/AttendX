# ---- Core ----
NODE_ENV=development
PORT=3000
# Must be an https:// URL in production if you want Secure cookies behind a proxy
MONGODB_URI=mongodb://127.0.0.1:27017/attendx
# Long random string (>= 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
SESSION_TTL_HOURS=8
# auto = Secure cookie only when NODE_ENV=production. Set true/false to force.
COOKIE_SECURE=auto
# Set to 1 when running behind a reverse proxy / load balancer that terminates TLS
TRUST_PROXY=1
# Comma separated list of extra browser origins allowed to call the API (same-origin needs none)
# URL of the web UI (CORS + password-reset links). The frontend proxies /api, so normally no extra origins are needed.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=
BCRYPT_ROUNDS=12
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info

# ---- Payments ----
# razorpay | simulator   (simulator is refused when NODE_ENV=production)
PAYMENT_PROVIDER=simulator
# Razorpay credentials: Dashboard > Settings > API Keys (use rzp_test_* keys for test mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks > secret you choose for https://<host>/api/fees/webhook
RAZORPAY_WEBHOOK_SECRET=

# ---- Uploads ----
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=2

# ---- Background jobs (minutes, 0 disables) ----
ALERT_JOB_INTERVAL_MIN=30
PAYMENT_RECONCILE_INTERVAL_MIN=10

# ---- Optional: path to a PNG logo printed on receipts ----
RECEIPT_LOGO_PATH=

# ---- Phase 2: public URL used in e-mailed links (password reset) ----
APP_BASE_URL=http://localhost:5173

# ---- E-mail (leave EMAIL_PROVIDER empty to disable; notifications are then in-app only and shown as "skipped") ----
# smtp
EMAIL_PROVIDER=
EMAIL_FROM="AttendX <no-reply@example.edu>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---- SMS (twilio; also needs "SMS enabled" in the college settings) ----
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- Notification queue ----
NOTIFY_MAX_ATTEMPTS=4
NOTIFY_QUEUE_INTERVAL_MIN=1

# ---- Operations ----
# Token for GET /ready (a signed-in user with system.health may also read it)
HEALTH_TOKEN=
JOBS_ENABLED=true
BACKUP_DIR=backups
# 64 hex characters (32 bytes) turns on AES-256-GCM encryption of backups. Keep it somewhere safe: without it a backup cannot be read.
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=14
BACKUP_KEEP_MIN=3
BACKUP_INTERVAL_HOURS=24
